<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.qualiadept.sl3.s12</groupId>
    <artifactId>sl3-s12-practice</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Valoare default pentru rularea testelor (rulează tot dacă nu se specifică altfel) -->
        <test.suite>**/*IT.java</test.suite>
    </properties>

    <dependencies>
        <!-- Source: https://mvnrepository.com/artifact/org.testng/testng -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.11.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Source: https://mvnrepository.com -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
            <scope>test</scope>
        </dependency>


        <!-- Source: https://mvnrepository.com/artifact/io.rest-assured/rest-assured -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>6.2.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <includes>
                        <!-- Surefire va folosi proprietatea dinamică injectată de profiluri -->
                        <include>${test.suite}</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Profilul QA: Rulează toate clasele de test -->
        <profile>
            <id>qa</id>
            <properties>
                <test.suite>**/*Test.java</test.suite>
            </properties>
        </profile>

        <!-- Profilul Extra Logging: Forțează Maven să afișeze loguri de tip INFO -->
        <profile>
            <id>extra-logging</id>
            <properties>
                <org.slf4j.simpleLogger.defaultLogLevel>error</org.slf4j.simpleLogger.defaultLogLevel>
            </properties>
        </profile>

        <!-- Profilul DEV: Rulează doar clasa SimpleApiTest.java -->
        <profile>
            <id>dev</id>
            <properties>
                <test.suite>**/SimpleApiTest.java</test.suite>
            </properties>
        </profile>
    </profiles>

</project>
